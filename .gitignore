# Local MCP server config — contains live credentials (Coolify access token,
# SSH password). Never commit.
.mcp.json

# Local agent/tooling state
.serena/
.codex/
.playwright-mcp/

# OS
.DS_Store

# Python bytecode from the local test suite
__pycache__/
*.pyc
deploy/*.env

# Mnemosyne -> Cognee seed corpora and the seeder's resume checkpoint. Scoped
# to where they are actually produced, so a JSONL test fixture committed under
# tests/ is not silently swallowed.
/*.jsonl
cognee-seed*.jsonl
*.jsonl.progress
/*.progress
